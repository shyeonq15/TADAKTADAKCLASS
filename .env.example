# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요. (.env.local 은 GitHub에 올라가지 않아요)
# 값 위치: Supabase 대시보드 → Project Settings → API Keys / Data API

# 예: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# 예: sb_publishable_xxxxxxxx (예전 방식이면 anon public 키, eyJ로 시작)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── 서버 전용 (절대 NEXT_PUBLIC_ 을 붙이지 마세요) ──
# Supabase 대시보드 → Project Settings → API Keys → Secret keys (sb_secret_...)
# 기록·점수 저장, PIN 로그인 계정 만들기에 씁니다. 채팅이나 GitHub에 올리지 마세요.
SUPABASE_SECRET_KEY=
# PIN 로그인 비밀번호를 만들 때 섞는 비밀 값 (아무 긴 무작위 문자열)
PIN_PEPPER=

# 학교 설정
SCHOOL_NAME=
# 이 도메인 구글 계정만 로그인 허용
ALLOWED_EMAIL_DOMAIN=senedu.kr
# 교사로 인정할 이메일 (여러 명이면 쉼표로)
TEACHER_EMAILS=
